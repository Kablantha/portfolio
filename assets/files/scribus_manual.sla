        <PageObject XPosition="752.0032" YPosition="39.8" OwnPage="1" ItemID="1337616311" ItemType="4" Width="531.9936" Height="175.36" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="9.36" TextToFrameDistanceTop="9.36" TextToFrameDistanceBottom="9.36" TextToFrameDistanceRight="9.72" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L531.994 0 L531.994 175.36 L0 175.36 L0 0 Z" ContourLinePath="M0 0 L531.994 0 L531.994 175.36 L0 175.36 L0 0 Z" gXpos="612" gYpos="-832" gWidth="531.9936" gHeight="744.361112195122" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle/>
                <Content Font="Arial Black" FontSize="24" FontColor="Card Red" ScaleVertical="100" BaselineOffset="29" Chars="On Your Turn"/>
                <para Alignment="0" LineSpacingMode="1"/>
                <Content FontSize="16" Chars="Roll a six-sided die and move that number of spaces toward the end goal. If there are multiple paths, you can choose which to take."/>
                <para Parent="Paragraph Boxes"/>
                <Content FontSize="16" Chars="Draw a card from the deck that matches the space you landed on. If the space is blank, your turn is complete."/>
                <para Parent="Paragraph Boxes"/>
                <Content FontSize="16" Chars="See below for how each card type is played."/>
                <trail Parent="Paragraph Boxes"/>
            </StoryText>
        </PageObject>
        <PageObject XPosition="752.0032" YPosition="365.832195122246" OwnPage="1" ItemID="1448424556" ItemType="4" Width="531.9936" Height="233.390243902437" CornerRadius="18.72" FrameType="2" ClipEdited="0" LineWidth="1" FillColor="Booklet Yellow" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="9.36" TextToFrameDistanceTop="9.36" TextToFrameDistanceBottom="9.36" TextToFrameDistanceRight="9.36" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 18.72 C0 8.38123 8.38123 0 18.72 0 L513.274 0 C523.612 0 531.994 8.38123 531.994 18.72 L531.994 214.67 C531.994 225.009 523.612 233.39 513.274 233.39 L18.72 233.39 C8.38123 233.39 0 225.009 0 214.67 L0 18.72 Z" ContourLinePath="M0 18.72 C0 8.38123 8.38123 0 18.72 0 L513.274 0 C523.612 0 531.994 8.38123 531.994 18.72 L531.994 214.67 C531.994 225.009 523.612 233.39 513.274 233.39 L18.72 233.39 C8.38123 233.39 0 225.009 0 214.67 L0 18.72 Z" gXpos="612" gYpos="-505.967804877752" gWidth="531.9936" gHeight="744.361112195122" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle/>
                <Content Font="Arial Black" FontSize="20" FontColor="Black" ScaleVertical="100" BaselineOffset="29" Chars="Scenarios and Violations"/>
                <para Parent="H2" Alignment="1"/>
                <Content FontSize="16" Chars="Scenarios and Violations present players with options that can either help or hinder. When a Scenario or Violation card is drawn, place it face up so it is visible to all players. All players must choose an option, regardless of who drew the card."/>
                <para Parent="Paragraph Boxes"/>
                <Content FontSize="16" Chars="Using your Choice Token, anonymously choose from the two options. Do not discuss this choice with your fellow players. After all choices are made, players reveal their choice and follow the instruction that matches."/>
                <trail Parent="Paragraph Boxes"/>
            </StoryText>
        </PageObject>
        <PageObject XPosition="752.0032" YPosition="217.227804877901" OwnPage="1" ItemID="715620026" ItemType="4" Width="531.9936" Height="146.536585366443" CornerRadius="18.36" FrameType="2" ClipEdited="0" LineWidth="1.00000075303376" FillColor="Card Green Pale" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="9.36" TextToFrameDistanceTop="9.36" TextToFrameDistanceBottom="9.36" TextToFrameDistanceRight="9.36" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 18.36 C0 8.22005 8.22005 0 18.36 0 L513.634 0 C523.774 0 531.994 8.22005 531.994 18.36 L531.994 128.177 C531.994 138.317 523.774 146.537 513.634 146.537 L18.36 146.537 C8.22005 146.537 0 138.317 0 128.177 L0 18.36 Z" ContourLinePath="M0 18.36 C0 8.22005 8.22005 0 18.36 0 L513.634 0 C523.774 0 531.994 8.22005 531.994 18.36 L531.994 128.177 C531.994 138.317 523.774 146.537 513.634 146.537 L18.36 146.537 C8.22005 146.537 0 138.317 0 128.177 L0 18.36 Z" gXpos="612" gYpos="-654.572195122096" gWidth="531.9936" gHeight="744.361112195122" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle BackgroundColor="None"/>
                <Content FontSize="20" FontColor="Black" BackgroundColor="None" Chars="Employment"/>
                <para Parent="H2" Alignment="1"/>
                <Content FontSize="16" BackgroundColor="None" Chars="Employment cards give you abilities that can change how you respond to other cards. Keep these in front of yo"/>
                <Content FontSize="16" BackgroundColor="None" ScaleHorizontal="99" ScaleVertical="102" Chars="u."/>
                <para Parent="Paragraph Boxes"/>
                <Content FontSize="16" BackgroundColor="None" ScaleHorizontal="99" ScaleVertical="102" Chars="If you alre"/>
                <Content FontSize="16" BackgroundColor="None" Chars="ady have an Employment card, you must discard it before accepting a different one."/>
                <trail Parent="Paragraph Boxes"/>
            </StoryText>
        </PageObject>
        <PageObject XPosition="752.0032" YPosition="601.290243902585" OwnPage="1" ItemID="1828306401" ItemType="4" Width="531.9936" Height="117.481951219514" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="9.36" TextToFrameDistanceTop="9.36" TextToFrameDistanceBottom="9.36" TextToFrameDistanceRight="9.36" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L531.994 0 L531.994 117.482 L0 117.482 L0 0 Z" ContourLinePath="M0 0 L531.994 0 L531.994 117.482 L0 117.482 L0 0 Z" gXpos="612" gYpos="-270.509756097417" gWidth="531.9936" gHeight="744.361112195122" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle/>
                <Content Font="Arial Black" FontSize="24" FontColor="Card Red" ScaleVertical="100" BaselineOffset="29" Chars="Reputation and Going to Prison"/>
                <para Alignment="0" LineSpacingMode="1"/>
                <Content FontSize="16" Chars="If, at any time, a player is reduced to zero Reputation Tokens, they must immediately move to the starting position and discard any Employment cards. They regain 10 Reputation Tokens before their next turn."/>
                <trail/>
            </StoryText>
        </PageObject>
        <PageObject XPosition="752.0032" YPosition="720.84" OwnPage="1" ItemID="1502097868" ItemType="4" Width="531.9936" Height="71.36" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="9.36" TextToFrameDistanceTop="9.36" TextToFrameDistanceBottom="9.36" TextToFrameDistanceRight="9.36" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L531.994 0 L531.994 71.36 L0 71.36 L0 0 Z" ContourLinePath="M0 0 L531.994 0 L531.994 71.36 L0 71.36 L0 0 Z" gXpos="612" gYpos="-150.959999999998" gWidth="531.9936" gHeight="744.361112195122" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle/>
                <Content Font="Arial Black" FontSize="24" FontColor="Card Red" ScaleVertical="100" BaselineOffset="29" Chars="Winning the Game"/>
                <para Alignment="0" LineSpacingMode="1"/>
                <Content FontSize="16" Chars="The first player to reach Reintegration is the winner! "/>
                <trail/>
            </StoryText>
        </PageObject>
