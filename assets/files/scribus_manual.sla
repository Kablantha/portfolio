            <StoryText>
                <DefaultStyle/>
                <Content Font="Arial Black" FontSize="24" FontColor="Card Red" ScaleVertical="100" BaselineOffset="29" Chars="Setting Up the Game"/>
                <para Alignment="0" LineSpacingMode="1"/>
                <Content Font="Arial Regular" FontSize="16" Chars="Each player puts their character token on the first space outside of Prison."/>
                <para Parent="Paragraph Boxes"/>
                <Content Font="Arial Regular" FontSize="16" Chars="Each player collects 10 Reputation Tokens"/>
                <para Parent="Paragraph Boxes"/>
                <Content Font="Arial Regular" FontSize="16" Chars="Each player rolls a six-sided die. The player with the highest result starts. Play will continue clockwise starting with this player."/>
