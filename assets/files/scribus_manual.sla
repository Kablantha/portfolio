            <StoryText>
                <DefaultStyle/>
                <Content Font="Arial Black" FontSize="24" FontColor="Card Red" ScaleVertical="100" BaselineOffset="29" Chars="Rules"/>
                <para Alignment="0" LineSpacingMode="1"/>
                <Content Font="Arial Regular" FontSize="16" Chars="Card instructions may override these rules."/>
                <para Parent="Paragraph Boxes"/>
                <Content Font="Arial Regular" FontSize="16" Chars="Players may not have more than 10 Reputation Tokens at any time"/>
                <para LineSpacingMode="0" LineSpacing="22" ParagraphEffectOffset="9" ParagraphEffectIndent="1" HasDropCap="0" Bullet="0" Numeration="1" NumerationFormat="0" NumerationName="&lt;local block&gt;" NumerationLevel="0" NumerationPrefix="" NumerationSuffix="." NumerationStart="1" NumerationOther="1" NumerationHigher="1"/>
                <Content Font="Arial Regular" FontSize="16" Chars="If a player has zero Reputation Tokens, they immediately return to the start and lose any Employment cards"/>
                <para LineSpacingMode="0" LineSpacing="22" ParagraphEffectOffset="9" ParagraphEffectIndent="1" HasDropCap="0" Bullet="0" Numeration="1" NumerationFormat="0" NumerationName="&lt;local block&gt;" NumerationLevel="0" NumerationPrefix="" NumerationSuffix="." NumerationStart="1" NumerationOther="1" NumerationHigher="1"/>
                <Content Font="Arial Regular" FontSize="16" Chars="All players must vote in Scenario and Violation events and follow the applicable instructions after resolution"/>
                <para LineSpacingMode="0" LineSpacing="22" ParagraphEffectOffset="9" ParagraphEffectIndent="1" HasDropCap="0" Bullet="0" Numeration="1" NumerationFormat="0" NumerationName="&lt;local block&gt;" NumerationLevel="0" NumerationPrefix="" NumerationSuffix="." NumerationStart="1" NumerationOther="1" NumerationHigher="1"/>
                <Content Font="Arial Regular" FontSize="16" Chars="Players may only have one Employment card in play at a time"/>
                <para LineSpacingMode="0" LineSpacing="22" ParagraphEffectOffset="9" ParagraphEffectIndent="1" HasDropCap="0" Bullet="0" Numeration="1" NumerationFormat="0" NumerationName="&lt;local block&gt;" NumerationLevel="0" NumerationPrefix="" NumerationSuffix="." NumerationStart="1" NumerationOther="1" NumerationHigher="1"/>
                <Content FontSize="16" Chars="Moving as the result of a Scenario or Violation card does not trigger a new event"/>
                <para LineSpacingMode="0" LineSpacing="22" ParagraphEffectOffset="9" ParagraphEffectIndent="1" HasDropCap="0" Bullet="0" Numeration="1" NumerationFormat="0" NumerationName="&lt;local block&gt;" NumerationLevel="0" NumerationPrefix="" NumerationSuffix="." NumerationStart="1" NumerationOther="1" NumerationHigher="1"/>
                <Content Font="Arial Regular" FontSize="16" Chars="Be the first player to reach Reintegration to win!"/>
                <trail ParagraphEffectOffset="9" ParagraphEffectIndent="1" HasDropCap="0" Bullet="0" Numeration="1" NumerationFormat="0" NumerationName="&lt;local block&gt;" NumerationLevel="0" NumerationPrefix="" NumerationSuffix="." NumerationStart="1" NumerationOther="1" NumerationHigher="1"/>
