        <PageObject XPosition="140" YPosition="3826.0652173913" OwnPage="7" ItemID="2117759856" ItemType="4" Width="266" Height="273.934782608696" FrameType="0" ClipEdited="0" LineWidth="9" LineColor="Black" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L266 0 L266 273.935 L0 273.935 L0 0 Z" ContourLinePath="M0 0 L266 0 L266 273.935 L0 273.935 L0 0 Z" gXpos="140" gYpos="2162.06521739131" gWidth="0" gHeight="0" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle/>
                <Content Font="Bebas Neue Regular" FontSize="24" Chars="Backstory"/>
                <para Parent="Header 1"/>
                <Content Chars="Liz is a former gifted kid. She is a software engineer for a Silicon Valley tech startup. She works remotely and is very efficient, which gives her extra time to work on her own projects. She has ADHD and several unfinished projects that she lost interest in. She knows that she is meant to do something amazing but doesn’t know what it is. She is very nerdy and loves both video games and comic books. "/>
                <para/>
                <Content Chars="Liz is a lesbian and currently unpartnered. She often bemoans the dating landscape of her city and the dating apps she uses to find companionship, but she doesn’t stop searching for her true love. "/>
                <trail/>
            </StoryText>
        </PageObject>
