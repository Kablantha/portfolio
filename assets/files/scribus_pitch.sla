        <PageObject XPosition="752" YPosition="2994.0652173913" OwnPage="6" ItemID="1344489907" ItemType="4" Width="266" Height="273.934782608696" FrameType="0" ClipEdited="0" LineWidth="9" LineColor="Black" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L266 0 L266 273.935 L0 273.935 L0 0 Z" ContourLinePath="M0 0 L266 0 L266 273.935 L0 273.935 L0 0 Z" gXpos="140" gYpos="2162.06521739131" gWidth="0" gHeight="0" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle/>
                <Content Font="Bebas Neue Regular" FontSize="24" Chars="Backstory"/>
                <para Parent="Header 1"/>
                <Content Chars="Carter is an elementary school art teacher. He grew up watching "/>
                <Content Font="Exo 2 Italic" Chars="Power Rangers"/>
                <Content Chars=" and never lost his love for multi-colored costumed hero teams. This love inspired him to explore the history of "/>
                <Content Font="Exo 2 Italic" Chars="Super Sentai"/>
                <Content Chars=", the Japanese show that inspired "/>
                <Content Font="Exo 2 Italic" Chars="Power Rangers"/>
                <Content Chars=". He has collected a ton of action figures, morphers, and other toys. He hopes to share these with his children someday. "/>
                <para/>
                <Content Chars="Carter’s enthusiasm is infectious, especially when he is talking about his special interests. He speaks about things he loves with a passion that can melt even the iciest demeanor.  "/>
                <para/>
                <Content Chars="He is married to Colin. He feels guilty that Colin works in a boring office job to help get him through school and support their family. "/>
                <trail/>
            </StoryText>
        </PageObject>
