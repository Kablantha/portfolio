        <PageObject XPosition="140.347826086957" YPosition="892" OwnPage="1" ItemID="2063900526" ItemType="4" Width="531.652173913043" Height="28.8" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L531.652 0 L531.652 28.8 L0 28.8 L0 0 Z" ContourLinePath="M0 0 L531.652 0 L531.652 28.8 L0 28.8 L0 0 Z" gXpos="0.347826086956502" gYpos="0" gWidth="532" gHeight="141.208695652174" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle/>
                <Content FontSize="28" Chars="What is "/>
                <Content Font="Bebas Neue Regular" FontSize="28" Chars="Rainbow Brigade?"/>
                <trail Parent="Header 1"/>
            </StoryText>
        </PageObject>
        <PageObject XPosition="140" YPosition="920.8" OwnPage="1" ItemID="844397644" ItemType="4" Width="532" Height="112.408695652174" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L532 0 L532 112.409 L0 112.409 L0 0 Z" ContourLinePath="M0 0 L532 0 L532 112.409 L0 112.409 L0 0 Z" gXpos="0" gYpos="28.8" gWidth="532" gHeight="141.208695652174" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle/>
                <Content FontSize="12" Chars="Rainbow Brigade is a semi-open world CRPG in the vein of Baldur’s Gate 3 or Divinity: Original Sin. It focuses on a group of six adult friends who gain extraordinary abilities which they use to protect their community and each other. Players will experience victory and defeat alongside the core team of characters, culminating in a story of trials, triumph, and overcoming impossible odds. "/>
                <para/>
                <Content FontSize="12" Chars="It is heavily inspired by the tokusatsu genre of shows, especially "/>
                <Content Font="Exo 2 Italic" FontSize="12" Chars="Power Rangers"/>
                <Content FontSize="12" Chars=" (and its Japanese counterpart "/>
                <Content Font="Exo 2 Italic" FontSize="12" Chars="Super Sentai"/>
                <Content FontSize="12" Chars=") and "/>
                <Content Font="Exo 2 Italic" FontSize="12" Chars="Kamen Rider"/>
                <Content FontSize="12" Chars=". "/>
                <trail/>
            </StoryText>
        </PageObject>
        <PageObject XPosition="366.347826086957" YPosition="1906.32" OwnPage="3" ItemID="1035226438" ItemType="2" Width="300.652173913043" Height="180.68" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="-4.89130434782606" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" ImagePageNumber="0" ImageFileName="Red BG.png" ImageProfile="Embedded sRGB built-in" ImageColorimetricIntent="0" EmbeddedProfile="Embedded sRGB built-in" Path="M0 0 L300.652 0 L300.652 180.68 L0 180.68 L0 0 Z" ContourLinePath="M0 0 L300.652 0 L300.652 180.68 L0 180.68 L0 0 Z" gXpos="366.347826086957" gYpos="1906.32" gWidth="0" gHeight="0" Layer="0" NextItem="-1" BackItem="-1"/>
        <PageObject XPosition="140" YPosition="1396.7652173913" OwnPage="1" ItemID="944174542" ItemType="12" Width="532" Height="207.234782608696" FrameType="0" ClipEdited="0" AutoName="Group1" GroupWidth="532" GroupHeight="207.234782608696" GroupClipping="1" Path="M0 0 L532 0 L532 207.235 L0 207.235 L0 0 Z" ContourLinePath="M0 0 L532 0 L532 207.235 L0 207.235 L0 0 Z" gXpos="140" gYpos="1396.7652173913" gWidth="0" gHeight="0" Layer="0">
            <PageObject XPosition="140" YPosition="1049.32173913043" OwnPage="1" ItemID="1379195039" ItemType="4" Width="532" Height="24.4173913043478" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L532 0 L532 24.4174 L0 24.4174 L0 0 Z" ContourLinePath="M0 0 L532 0 L532 24.4174 L0 24.4174 L0 0 Z" gXpos="0" gYpos="0" gWidth="532" gHeight="207.234782608696" Layer="0" NextItem="-1" BackItem="-1">
                <StoryText>
                    <DefaultStyle/>
                    <Content Chars="Plot Overview"/>
                    <trail Parent="Header 1"/>
                </StoryText>
            </PageObject>
            <PageObject XPosition="140" YPosition="1073.73913043478" OwnPage="1" ItemID="2112343716" ItemType="4" Width="532" Height="182.817391304348" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L532 0 L532 182.817 L0 182.817 L0 0 Z" ContourLinePath="M0 0 L532 0 L532 182.817 L0 182.817 L0 0 Z" gXpos="0" gYpos="24.4173913043478" gWidth="532" gHeight="207.234782608696" Layer="0" NextItem="-1" BackItem="-1">
                <StoryText>
                    <DefaultStyle/>
                    <Content Chars="On the far-off world of Synthax One, a spaceship is launched containing six organisms that bridge the gap between biology and technology. These biocomputers have the unique ability to create a permanent bond with a sentient lifeform, granting them incredible superpowers. "/>
                    <para/>
                    <Content Chars="On the somewhat closer world of Earth, six friends are walking through the park after a late dinner together. They have been friends for years and are now adults with their own jobs, relationships, and responsibilities. Their lives are changed forever when a meteor crashes in the forest nearby and they decide to investigate. "/>
                    <para/>
                    <Content Chars="Suddenly armed with the fantastic ability to create armor and weapons out of “hard light,” these six friends are thrust into the middle of a conflict that has been raging on Synthax One for years. The villainous Vince O'Ruin is determined to make Earth his own using his army of monsters. Only six millennials with powers they don’t understand stand in the way of his total dominion. "/>
                    <trail/>
                </StoryText>
            </PageObject>
        </PageObject>
