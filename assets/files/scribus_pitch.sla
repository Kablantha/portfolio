        <PageObject XPosition="752" YPosition="2157.7376" OwnPage="4" ItemID="1666097898" ItemType="4" Width="275.291304347826" Height="278.2624" FrameType="0" ClipEdited="0" LineWidth="9" LineColor="Black" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L275.291 0 L275.291 278.262 L0 278.262 L0 0 Z" ContourLinePath="M0 0 L275.291 0 L275.291 278.262 L0 278.262 L0 0 Z" gXpos="140" gYpos="2157.7376" gWidth="0" gHeight="0" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle/>
                <Content Font="Bebas Neue Regular" FontSize="24" Chars="Backstory"/>
                <para Parent="Header 1"/>
                <Content Chars="Morgan is a metal sculpture artist in her late-30s. Her art often focuses on the struggles of marginalized people, though it is often misunderstood. She is an activist and protester who feels strongly about keeping the most vulnerable members of her community safe. "/>
                <para/>
                <Content Chars="She previously dated Liz, and though they are no longer together, they remain good friends. Morgan devotes all the energy she would put into a relationship into her art and her activism. "/>
                <para/>
                <Content Chars="Morgan often comes across as abrasive, but her friends know that she is merely direct. That directness, when mixed with her passion, can often be misinterpreted as aggression."/>
                <trail/>
            </StoryText>
        </PageObject>
