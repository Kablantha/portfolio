        <PageObject XPosition="140" YPosition="2156.53739130435" OwnPage="3" ItemID="466635111" ItemType="4" Width="266" Height="279.462608695653" FrameType="0" ClipEdited="0" LineWidth="9" LineColor="Black" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L266 0 L266 279.463 L0 279.463 L0 0 Z" ContourLinePath="M0 0 L266 0 L266 279.463 L0 279.463 L0 0 Z" gXpos="140" gYpos="2156.53739130435" gWidth="0" gHeight="0" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle/>
                <Content Font="Bebas Neue Regular" FontSize="24" Chars="Backstory"/>
                <para Parent="Header 1"/>
                <Content Chars="Rin is a millennial and grew up during the early days of the Internet. They have a small group of friends who they are intensely dedicated to, but do not get to see as much as they would like. They are considered the “realistic” one in the friend group. Their down-to-earth nature and way of seeing all sides of an issue have made them the de facto judge when conflicts arise.  "/>
                <para/>
                <Content Chars="They struggle to find their place in the world, never finding their calling despite years of searching. They are a hobby musician but have never felt a pull toward music as a profession. "/>
                <trail/>
            </StoryText>
        </PageObject>
