        <PageObject XPosition="752" YPosition="920.8" OwnPage="2" ItemID="219229334" ItemType="4" Width="532" Height="240.001530434783" FrameType="0" ClipEdited="0" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L532 0 L532 240.002 L0 240.002 L0 0 Z" ContourLinePath="M0 0 L532 0 L532 240.002 L0 240.002 L0 0 Z" gXpos="752" gYpos="920.8" gWidth="0" gHeight="0" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle/>
                <Content Chars="Combat Interface"/>
                <para Parent="Header 2"/>
                <Content Chars="The combat interface takes inspiration from JRPGs like Persona 5 (interface pictured below). Like Persona 5, the menu should take advantage of all face buttons rather than the more traditional method using the arrow keys to select an option, with a single “confirm” button. "/>
                <para/>
                <Content Chars="The colors of the interface will be bright and appear to be plastic, in the style of the toyetic weapons used in tokusatsu shows. In the event of a submenu, as in the “Create Construct” action, submenu content will replace the main menu. "/>
                <para/>
                <Content Chars="The interface will also contain the party members’ health, stamina, and any status effects they are under. This section will be out of the way but still visible, likely in the top right corner. The currently acting character’s information will be larger to draw attention and make it easier for players to locate. "/>
                <trail/>
            </StoryText>
        </PageObject>
