        <PageObject XPosition="140" YPosition="2994.0652173913" OwnPage="5" ItemID="1435324191" ItemType="4" Width="266" Height="273.934782608696" FrameType="0" ClipEdited="0" LineWidth="9" LineColor="Black" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L266 0 L266 273.935 L0 273.935 L0 0 Z" ContourLinePath="M0 0 L266 0 L266 273.935 L0 273.935 L0 0 Z" gXpos="140" gYpos="2162.06521739131" gWidth="0" gHeight="0" Layer="0" NextItem="-1" BackItem="-1">
            <StoryText>
                <DefaultStyle/>
                <Content Font="Bebas Neue Regular" FontSize="24" Chars="Backstory"/>
                <para Parent="Header 1"/>
                <Content Chars="Colin works in a generic office setting. His friends often speculate on what his job is, but it is too boring for them to investigate. He is the only person in his friend group with a “traditional” job. He took it to support Carter through college and stayed to provide financial security for his family. He dreams of being an author “someday.” "/>
                <para/>
                <Content Chars="Colin is married to Carter. The two are the epitome of “opposites attract” from the outside. Colin appears to be reserved, but his friends know that he loves fiercely and always seeks to protect those he cares about. He has a very dry sense of humor and will roast you with a straight face. "/>
                <trail/>
            </StoryText>
        </PageObject>
        <PageObject XPosition="462.608862670487" YPosition="2994.0652173913" OwnPage="5" ItemID="1868797404" ItemType="4" Width="208.521739130435" Height="273.934782608696" FrameType="0" ClipEdited="0" LineWidth="9" LineColor="Black" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="1" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L208.522 0 L208.522 273.935 L0 273.935 L0 0 Z" ContourLinePath="M0 0 L208.522 0 L208.522 273.935 L0 273.935 L0 0 Z" gXpos="462.608862670487" gYpos="2162.06521739131" gWidth="0" gHeight="0" Layer="0" NextItem="-1" BackItem="-1">
